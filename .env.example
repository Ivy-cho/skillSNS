# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Callback URL — 프론트엔드의 콜백 페이지로 리다이렉트 (user-service/.env에서 실제 사용).
# Supabase 대시보드 → Authentication → URL Configuration → Redirect URLs 에도 동일하게 등록 필요.
# (로컬: localhost:3000, 배포: 실제 프론트 도메인)
CALLBACK_URL=http://localhost:3000/auth/callback

# frontend를 docker compose로 빌드할 때 쓰는 빌드 인자 (NEXT_PUBLIC_*라 빌드 시점에 번들에 박힘).
# DEV_TOKEN은 로그인 UI 붙기 전까지 쓰는 임시 서명 토큰 — skill-service/app/core/config.py의
# JWT_SECRET_KEY로 직접 서명해서 발급 (README "6. 프론트엔드 연동 테스트" 참고).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8002
NEXT_PUBLIC_USER_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_DEV_TOKEN=
